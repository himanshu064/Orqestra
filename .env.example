# ------------------------------------------------------------------------------
# Orqestra  Environment Variables
# Copy this file to `.env.local` and fill in values as each phase needs them.
# `.env.local` is git-ignored; never commit real secrets.
# ------------------------------------------------------------------------------

# --- Core (required from the phase noted) -------------------------------------

# Postgres connection string (Neon). Required from Phase 1.
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/orqestra?sslmode=require
DATABASE_URL=

# Secret used by Auth.js (NextAuth) to sign sessions/JWTs. Required from Phase 3.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=


# Key used to encrypt Bring-Your-Own LLM provider API keys at rest in the DB.
# Required from Phase 4. Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# Public base URL of the app (used for absolute links / callbacks).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (optional) ---------------------------------------------------------
# Resend API key. When set, an APPROVED "send_email" action is actually sent via
# Resend; when blank, sends are mocked (recorded but not delivered).
EMAIL_API_KEY=
# Verified sender. Defaults to Resend's onboarding address if blank.
# NOTE: with the default onboarding@resend.dev you can ONLY send to the email that
# owns the Resend account. To email arbitrary recipients, verify a domain in Resend
# and set e.g.  EMAIL_FROM="Orqestra <ops@yourdomain.com>"
EMAIL_FROM=

# --- Later phases (leave blank for now) ---------------------------------------
# LLM provider API keys are NOT set here  they are entered in Settings and stored
# encrypted in the database (requirements §55).

# VECTOR_DB_URL=          # only if a separate vector store is introduced (default: pgvector in DATABASE_URL)
# CRM_API_KEY=            # real CRM (HubSpot/Salesforce)  mocked in MVP
# WEB_SEARCH_API_KEY=     # live web research (V2)
# REDIS_URL=              # background jobs / caching (V2)
